              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Unknown file"
          }
        }
      },
      "post": {
        "summary": "post /files",
        "responses": {
          "200": {
            "description": "Google response subset; see provider documentation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Unknown file"
          }
        }
      }
    },
    "/files/{fileId}": {
      "get": {
        "summary": "get /files/{fileId}",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Google response subset; see provider documentation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Unknown file"
          }
        }
      },
      "patch": {
        "summary": "patch /files/{fileId}",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Google response subset; see provider documentation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Unknown file"
          }
        }
      }
    },
    "/files/{fileId}/permissions": {
      "parameters": [
        {
          "name": "fileId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "List existing user permissions",
        "responses": {
          "200": {
            "description": "Drive resource or permission metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Invite a pending consumer owner or transfer Workspace ownership",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role",
                  "type",
                  "emailAddress"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "writer",
                      "owner"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "user"
                    ]
                  },
                  "emailAddress": {
                    "type": "string"
                  },
                  "pendingOwner": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drive resource or permission metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ownership transfer"
          },
          "403": {
            "description": "Policy or storage restrictions"
          }
        }
      }
    },
    "/files/{fileId}/permissions/{permissionId}": {
      "parameters": [
        {
          "name": "fileId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "permissionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Accept pending ownership with the destination token or update an existing permission",
        "parameters": [
          {
            "name": "transferOwnership",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "pendingOwner": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drive resource or permission metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transfer"
          },
          "403": {
            "description": "Policy restriction"
          }
        }
      }
    }
  }
