{
  "openapi": "3.0.3",
  "info": {
    "title": "Google storage integration dependency",
    "version": "1.1.0",
    "description": "Task-specific subset of Google OAuth and Drive v3. Sources: developers.google.com/identity/protocols/oauth2/web-server and developers.google.com/workspace/drive/api/reference/rest/v3/files. Ownership transfer follows https://developers.google.com/workspace/drive/api/guides/transfer-file. Pagination and ownership verification are exercised by scripts/google-storage-transfer.test.mjs against the local HTTP provider."
  },
  "paths": {
    "/token": {
      "post": {
        "summary": "post /token",
        "responses": {
          "200": {
            "description": "Google response subset; see provider documentation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Unknown file"
          }
        }
      }
    },
    "/about": {
      "get": {
        "summary": "get /about",
        "responses": {
          "200": {
