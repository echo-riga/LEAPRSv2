{
  "hooks": [
    {
      "id": "typescript-check",
      "description": "Run TypeScript type check after file edits",
      "event": "post_tool_use",
      "toolNames": [
        "write_file",
        "apply_patch"
      ],
      "command": "npx tsc --noEmit",
      "timeoutMs": 60000,
      "blocking": false
    },
    {
      "id": "block-env-writes",
      "description": "Block writes to .env files",
      "event": "pre_tool_use",
      "toolNames": [
        "write_file",
        "apply_patch"
      ],
      "command": "node -e \"const args = JSON.parse(require(\"fs\").readFileSync(0, \"utf-8\")); if (args.toolArgs.path?.endsWith(\".env\")) process.exit(1);\"",
      "timeoutMs": 5000,
      "blocking": true
    },
    {
      "id": "lint-on-edit",
      "description": "Run ESLint on edited files",
      "event": "post_tool_use",
      "toolNames": [
        "write_file",
        "apply_patch"
      ],
      "command": "npx eslint --quiet",
      "timeoutMs": 30000,
      "blocking": false
    }
  ]
}